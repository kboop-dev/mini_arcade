rules_version = '2';

// ============================================================================
// Reglas de seguridad de Firestore.
// La "API key" de Firebase para apps web NO es secreta (es normal que sea
// pública en el código); lo que realmente protege tus datos son ESTAS
// reglas. Súbelas con: firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y escribir su propio documento de perfil/progreso
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Progreso de rompecabezas guardado por el propio usuario
      match /puzzle_progress/{puzzleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Nota: los tickets (ticketsUnlocked) NO son una subcolección, son un
      // campo tipo mapa dentro del propio documento de users/{userId}, así
      // que ya quedan protegidos por la regla de arriba. No se necesita una
      // regla aparte para ellos.
    }

    // Nota: el catálogo de tickets y las fotos del rompecabezas oficial NO
    // viven en Firestore — están directamente en el código de Flutter
    // (lib/models/ticket_catalog.dart y assets/images/puzzles/), así que no
    // se necesitan reglas para ellos.

    // Todo lo demás: denegado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
